{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.repo/schemas/headroom-dashboard-metrics-schema.json",
  "title": "Headroom-Only Dashboard Metrics Schema",
  "description": "Phase 0/1 schema for Headroom dashboard health and stats telemetry only. It intentionally excludes retrieval, compression, latency KPI, and CodeGraph health metrics until those cards are promoted into the active pilot scope.",
  "type": "object",
  "required": [
    "scope",
    "schema_version",
    "event_type",
    "timestamp",
    "repo_context",
    "dashboard_context",
    "sidecar_context",
    "status"
  ],
  "properties": {
    "scope": {
      "type": "string",
      "const": "headroom_only",
      "description": "Marks this schema as the Headroom-only pilot contract. Full observability KPI events require a later schema version."
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "dashboard_loaded",
        "dashboard_refresh_started",
        "dashboard_refresh_completed",
        "dashboard_refresh_failed",
        "sidecar_health_checked",
        "sidecar_stats_checked",
        "fallback_activated",
        "config_loaded",
        "config_missing",
        "config_invalid"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "repo_context": {
      "type": "object",
      "required": [
        "prompt_contract_path",
        "skill_source_root",
        "runtime_adapter_root",
        "pilot_config_path"
      ],
      "properties": {
        "prompt_contract_path": { "type": "string" },
        "skill_source_root": { "type": "string" },
        "runtime_adapter_root": {
          "type": "string",
          "enum": [".claude/skills", ".codex/skills", "unknown"]
        },
        "pilot_config_path": { "type": "string" },
        "manifest_path": { "type": "string" },
        "cross_review_rule": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dashboard_context": {
      "type": "object",
      "required": [
        "extension_id",
        "activitybar_container_id",
        "sidebar_view_id",
        "poll_interval_ms"
      ],
      "properties": {
        "extension_id": { "type": "string" },
        "activitybar_container_id": { "type": "string" },
        "sidebar_view_id": { "type": "string" },
        "poll_interval_ms": { "type": "integer", "minimum": 500 },
        "request_timeout_ms": { "type": "integer", "minimum": 100 },
        "config_source": {
          "type": "string",
          "enum": ["pilot.config.json", "environment", "built_in_default"]
        }
      },
      "additionalProperties": false
    },
    "sidecar_context": {
      "type": "object",
      "required": ["service", "endpoint_base"],
      "properties": {
        "service": {
          "type": "string",
          "enum": ["headroom"],
          "description": "Headroom is the only active sidecar service in this schema. CodeGraph fields remain reserved in pilot.config.json but are not validated here."
        },
        "endpoint_base": { "type": "string", "format": "uri" },
        "health_path": { "type": "string" },
        "stats_path": { "type": "string" },
        "health_url": { "type": "string", "format": "uri" },
        "stats_url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "required": ["state_lamp", "fallback_active"],
      "properties": {
        "state_lamp": {
          "type": "string",
          "enum": ["green", "yellow", "red", "gray"]
        },
        "fallback_active": { "type": "boolean" },
        "health_http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "stats_http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "checked_at": { "type": ["string", "null"], "format": "date-time" },
        "config_error": { "type": ["string", "null"] },
        "failure_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "refresh_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "health_response_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "stats_response_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "parse_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "consecutive_failures": { "type": ["integer", "null"], "minimum": 0 },
        "fallback_count": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "raw_payload": {
      "type": ["object", "null"]
    }
  },
  "additionalProperties": false
}
