{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.repo/schemas/retrieval-compression-kpi-schema.json",
  "title": "Retrieval and Compression KPI Evidence Schema",
  "description": "Draft companion schema for the next dashboard phase. It defines retrieval, compression, fallback-rate, and latency KPI event shape without changing the active Headroom-only health/stats contract.",
  "type": "object",
  "required": [
    "scope",
    "schema_version",
    "event_type",
    "source_kind",
    "timestamp",
    "repo_context",
    "dashboard_context",
    "request_context",
    "kpi"
  ],
  "properties": {
    "scope": {
      "type": "string",
      "const": "retrieval_compression_kpi_draft"
    },
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "kpi_snapshot_emitted",
        "retrieval_query_completed",
        "retrieval_query_failed",
        "compression_completed",
        "compression_failed",
        "fallback_rate_snapshot_emitted",
        "latency_snapshot_emitted"
      ]
    },
    "source_kind": {
      "type": "string",
      "enum": ["real", "fixture"],
      "description": "Evidence provenance. Only real events are eligible for promotion evidence."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "repo_context": {
      "type": "object",
      "required": [
        "prompt_contract_path",
        "skill_source_root",
        "runtime_adapter_root",
        "pilot_config_path"
      ],
      "properties": {
        "prompt_contract_path": { "type": "string" },
        "skill_source_root": { "type": "string" },
        "runtime_adapter_root": {
          "type": "string",
          "enum": [".claude/skills", ".codex/skills", "unknown"]
        },
        "pilot_config_path": { "type": "string" },
        "skill_name": { "type": ["string", "null"] },
        "skill_classification": {
          "type": ["string", "null"],
          "enum": ["common", "runtime_adapter", "repo_local", "system", null]
        },
        "adapter_runtime": {
          "type": ["string", "null"],
          "enum": ["claude", "codex", "gemini", "unknown", null]
        }
      },
      "additionalProperties": false
    },
    "dashboard_context": {
      "type": "object",
      "required": [
        "extension_id",
        "sidebar_view_id",
        "dashboard_view_id"
      ],
      "properties": {
        "extension_id": { "type": "string" },
        "sidebar_view_id": { "type": "string" },
        "dashboard_view_id": { "type": "string" },
        "card_id": {
          "type": "string",
          "enum": [
            "retrievalHitRate",
            "compressionRatio",
            "fallbackRate",
            "endToEndP95Latency"
          ]
        },
        "sample_window_seconds": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "request_context": {
      "type": "object",
      "required": [
        "request_id",
        "agent",
        "task_type"
      ],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": ["string", "null"] },
        "agent": {
          "type": "string",
          "enum": ["claude", "codex", "gemini", "human", "unknown"]
        },
        "task_type": {
          "type": "string",
          "enum": [
            "code_review",
            "implementation",
            "documentation",
            "architecture",
            "qa",
            "sv",
            "unknown"
          ]
        },
        "model": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "kpi": {
      "type": "object",
      "required": [
        "retrieval",
        "compression",
        "fallback",
        "latency"
      ],
      "properties": {
        "retrieval": {
          "type": "object",
          "required": [
            "used_retrieval",
            "retrieval_hit_rate"
          ],
          "properties": {
            "used_retrieval": { "type": "boolean" },
            "used_codegraph": { "type": ["boolean", "null"] },
            "retrieval_hit": { "type": ["boolean", "null"] },
            "retrieval_hit_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "query_count": { "type": ["integer", "null"], "minimum": 0 },
            "retrieved_items": { "type": ["integer", "null"], "minimum": 0 },
            "accepted_items": { "type": ["integer", "null"], "minimum": 0 },
            "top_k": { "type": ["integer", "null"], "minimum": 1 },
            "retrieval_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
            "source_count": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "compression": {
          "type": "object",
          "required": [
            "compression_enabled",
            "input_tokens_estimated",
            "output_tokens_estimated",
            "token_keep_ratio",
            "token_savings_rate"
          ],
          "properties": {
            "compression_enabled": { "type": "boolean" },
            "input_tokens_estimated": { "type": "integer", "minimum": 0 },
            "output_tokens_estimated": { "type": "integer", "minimum": 0 },
            "tokens_saved_estimated": { "type": ["integer", "null"] },
            "token_keep_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "output_tokens_estimated / input_tokens_estimated. Defined as 1 when both token counts are 0.",
              "x-formula": "output_tokens_estimated / input_tokens_estimated"
            },
            "token_savings_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "(input_tokens_estimated - output_tokens_estimated) / input_tokens_estimated. Defined as 0 when both token counts are 0.",
              "x-formula": "(input_tokens_estimated - output_tokens_estimated) / input_tokens_estimated"
            },
            "compression_duration_ms": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "fallback": {
          "type": "object",
          "required": [
            "fallback_active",
            "fallback_rate"
          ],
          "properties": {
            "fallback_active": { "type": "boolean" },
            "fallback_reason": { "type": ["string", "null"] },
            "fallback_count": { "type": ["integer", "null"], "minimum": 0 },
            "total_requests": { "type": ["integer", "null"], "minimum": 0 },
            "fallback_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "latency": {
          "type": "object",
          "required": [
            "end_to_end_latency_ms",
            "end_to_end_p95_latency_ms"
          ],
          "properties": {
            "end_to_end_latency_ms": { "type": ["integer", "null"], "minimum": 0 },
            "end_to_end_p50_latency_ms": { "type": ["integer", "null"], "minimum": 0 },
            "end_to_end_p95_latency_ms": { "type": ["integer", "null"], "minimum": 0 },
            "sidecar_overhead_ms": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "quality_proxy": {
      "type": "object",
      "properties": {
        "grounding_status": {
          "type": ["string", "null"],
          "enum": ["grounded", "partial", "ungrounded", "unknown", null]
        },
        "parse_error_count": { "type": ["integer", "null"], "minimum": 0 },
        "stale_context_detected": { "type": ["boolean", "null"] }
      },
      "additionalProperties": false
    },
    "raw_payload": {
      "type": ["object", "null"]
    }
  },
  "additionalProperties": false
}
