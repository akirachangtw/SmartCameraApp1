{
  "name": "vscode-headroom-dashboard",
  "displayName": "Headroom Dashboard",
  "description": "Minimal VS Code sidebar dashboard for Headroom sidecar health and stats.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:headroomDashboard.view",
    "onCommand:headroomDashboard.refresh",
    "onCommand:headroomDashboard.openConfig"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "headroomDashboard",
          "title": "Headroom",
          "icon": "media/headroom.svg"
        }
      ]
    },
    "views": {
      "headroomDashboard": [
        {
          "type": "webview",
          "id": "headroomDashboard.view",
          "name": "Local Sidecar"
        }
      ]
    },
    "commands": [
      {
        "command": "headroomDashboard.refresh",
        "title": "Headroom: Recheck Health"
      },
      {
        "command": "headroomDashboard.openConfig",
        "title": "Headroom: Open Pilot Config"
      }
    ]
  },
  "scripts": {
    "check": "npm run check:ts && node --check out/extension.js && node --check out/headroomViewProvider.js",
    "check:legacy": "node --check src/extension.js && node --check src/headroomViewProvider.js",
    "check:ts": "tsc --noEmit",
    "build": "tsc -p .",
    "package": "npm run build && vsce package --allow-missing-repository --out vscode-headroom-dashboard-0.0.1.vsix"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.90.0"
  }
}
