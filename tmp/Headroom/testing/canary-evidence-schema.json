{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cueshot.local/headroom/canary-evidence.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","source_kind","generated_at","route","metrics","promotion_verdict","requests"],
  "properties":{
    "schema_version":{"const":1},"source_kind":{"const":"real"},"generated_at":{"type":"string","format":"date-time"},
    "route":{"type":"object","additionalProperties":false,"required":["port","doctor_routed","requests_before","requests_after","request_delta"],"properties":{"port":{"type":"integer","minimum":1,"maximum":65535,"not":{"const":8787}},"doctor_routed":{"type":"boolean"},"requests_before":{"type":"integer","minimum":0},"requests_after":{"type":"integer","minimum":0},"request_delta":{"type":"integer","minimum":0}}},
    "metrics":{"type":"object","additionalProperties":false,"required":["qualified_token_savings_median","quality_average","fallback_rate","p95_overhead_ms","bypass_100_percent"],"properties":{"qualified_token_savings_median":{"type":"number","minimum":0,"maximum":1},"quality_average":{"type":"number","minimum":0,"maximum":5},"fallback_rate":{"type":"number","minimum":0,"maximum":1},"p95_overhead_ms":{"type":"number","minimum":0},"bypass_100_percent":{"type":"boolean"}}},
    "promotion_verdict":{"enum":["PASS","HOLD"]},
    "requests":{"type":"array","minItems":20,"maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["scenario_id","category","source_kind","session_id","request_ids","input_tokens","optimized_input_tokens","output_tokens","token_savings_rate","overhead_ms","elapsed_ms","fallback","quality","route","bypass_reason","bypass_verified","evidence_sha256"],"properties":{"scenario_id":{"type":"string","pattern":"^(log|tool|search|bypass)-0[1-5]$"},"category":{"enum":["logs","tool_outputs","search_listings","forced_bypass"]},"source_kind":{"const":"real"},"session_id":{"type":"string","minLength":1},"request_ids":{"type":"array","minItems":1,"items":{"type":"string"}},"input_tokens":{"type":"integer","minimum":0},"optimized_input_tokens":{"type":"integer","minimum":0},"output_tokens":{"type":"integer","minimum":0},"token_savings_rate":{"type":"number","minimum":0,"maximum":1},"overhead_ms":{"type":"number","minimum":0},"elapsed_ms":{"type":"integer","minimum":0},"fallback":{"type":"boolean"},"quality":{"type":"integer","minimum":0,"maximum":5},"route":{"enum":["eligible","bypass"]},"bypass_reason":{"type":["string","null"]},"bypass_verified":{"type":"boolean"},"evidence_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"}}}}
  }
}
