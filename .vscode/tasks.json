{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Build Emulator Debug",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["assembleEmulatorDebug"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "📱 Install to Emulator",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["installEmulatorDebug"],
      "group": "build",
      "dependsOn": ["🚀 Build Emulator Debug"],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Run Unit Tests",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["testEmulatorDebugUnitTest"],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🔍 Run Lint",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["lintEmulatorDebug"],
      "group": "test"
    },
    {
      "label": "🧹 Clean Build",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["clean"],
      "group": "build"
    },
    {
      "label": "📊 Generate Test Report",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["testEmulatorDebugUnitTest", "--tests", "*"],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🎯 Full Test Cycle",
      "dependsOrder": "sequence",
      "dependsOn": [
        "🧹 Clean Build",
        "🚀 Build Emulator Debug",
        "🧪 Run Unit Tests",
        "🔍 Run Lint"
      ],
      "group": "test"
    },
    {
      "label": "🚀 Build Device Debug",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["assembleDeviceDebug"],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "📱 Install to Device",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["installDeviceDebug"],
      "group": "build",
      "dependsOn": ["🚀 Build Device Debug"],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "📋 Hybrid: L1 Plan (inline input)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "L1",
        "--topic",
        "${input:hybridTopic}",
        "--input",
        "${input:hybridInput}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📋 Hybrid: L1 Plan (input_file)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "L1",
        "--topic",
        "${input:hybridTopic}",
        "--input_file",
        "${input:hybridInputFile}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📋 Hybrid: L2 Feasibility (inline input)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "L2",
        "--topic",
        "${input:hybridTopic}",
        "--issue",
        "${input:hybridIssuePath}",
        "--input",
        "${input:hybridInput}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📋 Hybrid: L2 Feasibility (input_file)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "L2",
        "--topic",
        "${input:hybridTopic}",
        "--issue",
        "${input:hybridIssuePath}",
        "--input_file",
        "${input:hybridInputFile}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📋 Hybrid: PR Notes (inline input)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "PR",
        "--topic",
        "${input:hybridTopic}",
        "--input",
        "${input:hybridInput}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🧪 Phase 1: Connect Device",
      "type": "shell",
      "command": "adb",
      "args": ["devices", "-l"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🧪 Phase 1: Start App",
      "type": "shell",
      "command": "adb",
      "args": [
        "shell",
        "am",
        "start",
        "-n",
        "com.akirachang.ai.photographer/.MainActivity"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Clear Logcat",
      "type": "shell",
      "command": "adb",
      "args": ["logcat", "-c"],
      "problemMatcher": []
    },
    {
      "label": "🧪 Phase 1: Monitor Logcat",
      "type": "shell",
      "command": "adb",
      "args": ["logcat", "-s", "LiveCameraSource:*"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🧪 Phase 1: Pull Photos",
      "type": "shell",
      "command": "adb",
      "args": ["pull", "/sdcard/DCIM/SmartCamera/", "tmp/phase1_photos/"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Analyze EXIF",
      "type": "shell",
      "command": "python",
      "args": ["tools/analyze_exif.py", "tmp/phase1_photos/"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Capture Portrait (0°)",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "adb shell settings put system user_rotation 0 && timeout /t 1 > nul && adb shell input tap 540 2100"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Capture Landscape Left (270°)",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "adb shell settings put system user_rotation 3 && timeout /t 2 > nul && adb shell input tap 540 2100"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Capture Landscape Right (90°)",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "adb shell settings put system user_rotation 1 && timeout /t 2 > nul && adb shell input tap 540 2100"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Reset Orientation",
      "type": "shell",
      "command": "adb",
      "args": ["shell", "settings", "put", "system", "user_rotation", "0"],
      "problemMatcher": []
    },
    {
      "label": "🧪 Phase 1: Full Test Sequence",
      "dependsOrder": "sequence",
      "dependsOn": [
        "🧪 Phase 1: Connect Device",
        "🧪 Phase 1: Clear Logcat",
        "🧪 Phase 1: Start App",
        "🧪 Phase 1: Monitor Logcat"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🧪 Phase 1: Capture All Orientations",
      "dependsOrder": "sequence",
      "dependsOn": [
        "🧪 Phase 1: Capture Portrait (0°)",
        "🧪 Phase 1: Capture Landscape Left (270°)",
        "🧪 Phase 1: Capture Landscape Right (90°)",
        "🧪 Phase 1: Reset Orientation"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Complete Test & Analysis",
      "dependsOrder": "sequence",
      "dependsOn": [
        "🧪 Phase 1: Pull Photos",
        "🧪 Phase 1: Analyze EXIF"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "📤 Test Handoff: 1. Home NB (Push)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Write-Host '📤 Test Handoff: 1. Home NB (Push)' -ForegroundColor Cyan; Write-Host ''; Write-Host 'Step 1: Checking git status...' -ForegroundColor Yellow; git status --short; Write-Host ''; Write-Host 'Step 2: Adding test handoff files...' -ForegroundColor Yellow; git add docs/test_handoff/; Write-Host ''; Write-Host 'Step 3: Committing...' -ForegroundColor Yellow; git commit -m '[Docs] Test handoff: ${input:testHandoffTopic}' -m 'Test Device: ${input:testHandoffDevice}' -m 'Test Objective: ${input:testHandoffObjective}' -m '' -m 'Co-Authored-By: Claude Sonnet 4.5 <noreply@anthropic.com>'; Write-Host ''; Write-Host 'Step 4: Pushing to GitHub...' -ForegroundColor Yellow; git push github main; Write-Host ''; Write-Host '✅ Test handoff pushed successfully!' -ForegroundColor Green; Write-Host ''; Write-Host '📋 Next step: Switch to Work NB and run \\"📥 Test Handoff: 2. Work NB (Pull)\\"' -ForegroundColor Cyan"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      "label": "📥 Test Handoff: 2. Work NB (Pull)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Write-Host '📥 Test Handoff: 2. Work NB (Pull)' -ForegroundColor Cyan; Write-Host ''; Write-Host 'Step 1: Pulling latest from GitHub...' -ForegroundColor Yellow; git pull origin main; Write-Host ''; Write-Host 'Step 2: Listing available test handoff docs...' -ForegroundColor Yellow; Get-ChildItem docs/test_handoff/*.md | Select-Object Name; Write-Host ''; Write-Host '✅ Test handoff pulled successfully!' -ForegroundColor Green; Write-Host ''; Write-Host '📋 Next steps:' -ForegroundColor Cyan; Write-Host '  1. Open Claude Code Chat' -ForegroundColor White; Write-Host '  2. Run: 引用 @docs/test_handoff/v2.9.6_phase1_work_nb_execution.md' -ForegroundColor White; Write-Host '  3. Ask Claude to execute tests and generate report' -ForegroundColor White; Write-Host '  4. After testing, run \\"📤 Test Handoff: 3. Work NB (Push)\\"' -ForegroundColor Cyan"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      "label": "📤 Test Handoff: 3. Work NB (Push)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Write-Host '📤 Test Handoff: 3. Work NB (Push)' -ForegroundColor Cyan; Write-Host ''; Write-Host 'Step 1: Checking git status...' -ForegroundColor Yellow; git status --short; Write-Host ''; Write-Host 'Step 2: Adding test results...' -ForegroundColor Yellow; git add docs/test_results/; Write-Host ''; Write-Host 'Step 3: Committing test results...' -ForegroundColor Yellow; $testResult = Read-Host 'Enter test result (PASS/FAIL)'; git commit -m '[Test] ${input:testHandoffTopic}: Test results - ' + $testResult -m 'Device: ${input:testHandoffDevice}' -m 'Tester: Claude Code (Work NB)' -m 'Date: ' + (Get-Date -Format 'yyyy-MM-dd') -m '' -m 'Co-Authored-By: Claude Sonnet 4.5 <noreply@anthropic.com>'; Write-Host ''; Write-Host 'Step 4: Pushing to GitHub...' -ForegroundColor Yellow; git push origin main; Write-Host ''; Write-Host '✅ Test results pushed successfully!' -ForegroundColor Green; Write-Host ''; Write-Host '📋 Next step: Switch to Home NB and run \\"📥 Test Handoff: 4. Home NB (Pull)\\"' -ForegroundColor Cyan"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      "label": "📥 Test Handoff: 4. Home NB (Pull)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Write-Host '📥 Test Handoff: 4. Home NB (Pull)' -ForegroundColor Cyan; Write-Host ''; Write-Host 'Step 1: Pulling latest from GitHub...' -ForegroundColor Yellow; git pull origin main; Write-Host ''; Write-Host 'Step 2: Listing test results...' -ForegroundColor Yellow; $reports = Get-ChildItem docs/test_results/*.md -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 5; if ($reports) { Write-Host 'Recent test reports:' -ForegroundColor Green; $reports | ForEach-Object { Write-Host \"  - $($_.Name) ($($_.LastWriteTime))\" }; Write-Host ''; $latest = $reports[0].FullName; Write-Host \"Opening latest report: $($reports[0].Name)\" -ForegroundColor Yellow; code $latest } else { Write-Host 'No test reports found.' -ForegroundColor Yellow }; Write-Host ''; Write-Host '✅ Test handoff cycle completed!' -ForegroundColor Green"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      "label": "🔄 Test Handoff: Full Cycle (Home)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "📤 Test Handoff: 1. Home NB (Push)",
        "📥 Test Handoff: 4. Home NB (Pull)"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "hybridTopic",
      "type": "promptString",
      "description": "輸入本次任務 topic（用於檔名）",
      "default": "camera_control_not_available"
    },
    {
      "id": "hybridInput",
      "type": "promptString",
      "description": "輸入需求/問題描述（可直接貼錯誤訊息、重現條件、裝置差異）",
      "default": "實體手機切回 Live 模式後呼叫 setZoomRatio 出現 CameraControl not available；模擬器未重現。"
    },
    {
      "id": "hybridInputFile",
      "type": "promptString",
      "description": "輸入 input_file 路徑（例如 logs/logcat.txt 或 notes/issue.md）",
      "default": "logs/logcat.txt"
    },
    {
      "id": "hybridIssuePath",
      "type": "promptString",
      "description": "輸入 Issue/計畫檔路徑（L2 建議填 L1 產出，如 docs/plan/<topic>_L1.md）",
      "default": "docs/plan/camera_control_not_available_L1.md"
    },
    {
      "id": "testHandoffTopic",
      "type": "promptString",
      "description": "輸入測試任務名稱（例如：v2.9.6_phase1）",
      "default": "v2.9.6_phase1"
    },
    {
      "id": "testHandoffDevice",
      "type": "promptString",
      "description": "輸入測試裝置名稱（例如：Pixel 9a, Sony XQ-BT52）",
      "default": "Pixel 9a"
    },
    {
      "id": "testHandoffObjective",
      "type": "promptString",
      "description": "輸入測試目標描述",
      "default": "Verify OrientationEventListener fix and photo EXIF orientation"
    }
  ]
}
