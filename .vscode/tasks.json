{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Build Emulator Debug",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["assembleEmulatorDebug"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "📱 Install to Emulator",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["installEmulatorDebug"],
      "group": "build",
      "dependsOn": ["🚀 Build Emulator Debug"],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Run Unit Tests",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["testEmulatorDebugUnitTest"],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🔍 Run Lint",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["lintEmulatorDebug"],
      "group": "test"
    },
    {
      "label": "🧹 Clean Build",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["clean"],
      "group": "build"
    },
    {
      "label": "📊 Generate Test Report",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["testEmulatorDebugUnitTest", "--tests", "*"],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🎯 Full Test Cycle",
      "dependsOrder": "sequence",
      "dependsOn": [
        "🧹 Clean Build",
        "🚀 Build Emulator Debug",
        "🧪 Run Unit Tests",
        "🔍 Run Lint"
      ],
      "group": "test"
    },
    {
      "label": "🚀 Build Device Debug",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["assembleDeviceDebug"],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "📱 Install to Device",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": ["installDeviceDebug"],
      "group": "build",
      "dependsOn": ["🚀 Build Device Debug"],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "📋 Hybrid: L1 Plan (inline input)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "L1",
        "--topic",
        "${input:hybridTopic}",
        "--input",
        "${input:hybridInput}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📋 Hybrid: L1 Plan (input_file)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "L1",
        "--topic",
        "${input:hybridTopic}",
        "--input_file",
        "${input:hybridInputFile}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📋 Hybrid: L2 Feasibility (inline input)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "L2",
        "--topic",
        "${input:hybridTopic}",
        "--issue",
        "${input:hybridIssuePath}",
        "--input",
        "${input:hybridInput}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📋 Hybrid: L2 Feasibility (input_file)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "L2",
        "--topic",
        "${input:hybridTopic}",
        "--issue",
        "${input:hybridIssuePath}",
        "--input_file",
        "${input:hybridInputFile}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📋 Hybrid: PR Notes (inline input)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "PR",
        "--topic",
        "${input:hybridTopic}",
        "--input",
        "${input:hybridInput}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🧪 Phase 1: Connect Device",
      "type": "shell",
      "command": "adb",
      "args": ["devices", "-l"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🧪 Phase 1: Start App",
      "type": "shell",
      "command": "adb",
      "args": [
        "shell",
        "am",
        "start",
        "-n",
        "com.akirachang.ai.photographer/.MainActivity"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Clear Logcat",
      "type": "shell",
      "command": "adb",
      "args": ["logcat", "-c"],
      "problemMatcher": []
    },
    {
      "label": "🧪 Phase 1: Monitor Logcat",
      "type": "shell",
      "command": "adb",
      "args": ["logcat", "-s", "LiveCameraSource:*"],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🧪 Phase 1: Pull Photos",
      "type": "shell",
      "command": "adb",
      "args": ["pull", "/sdcard/DCIM/SmartCamera/", "tmp/phase1_photos/"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Analyze EXIF",
      "type": "shell",
      "command": "python",
      "args": ["tools/analyze_exif.py", "tmp/phase1_photos/"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Capture Portrait (0°)",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "adb shell settings put system user_rotation 0 && timeout /t 1 > nul && adb shell input tap 540 2100"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Capture Landscape Left (270°)",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "adb shell settings put system user_rotation 3 && timeout /t 2 > nul && adb shell input tap 540 2100"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Capture Landscape Right (90°)",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "adb shell settings put system user_rotation 1 && timeout /t 2 > nul && adb shell input tap 540 2100"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Reset Orientation",
      "type": "shell",
      "command": "adb",
      "args": ["shell", "settings", "put", "system", "user_rotation", "0"],
      "problemMatcher": []
    },
    {
      "label": "🧪 Phase 1: Full Test Sequence",
      "dependsOrder": "sequence",
      "dependsOn": [
        "🧪 Phase 1: Connect Device",
        "🧪 Phase 1: Clear Logcat",
        "🧪 Phase 1: Start App",
        "🧪 Phase 1: Monitor Logcat"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🧪 Phase 1: Capture All Orientations",
      "dependsOrder": "sequence",
      "dependsOn": [
        "🧪 Phase 1: Capture Portrait (0°)",
        "🧪 Phase 1: Capture Landscape Left (270°)",
        "🧪 Phase 1: Capture Landscape Right (90°)",
        "🧪 Phase 1: Reset Orientation"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "🧪 Phase 1: Complete Test & Analysis",
      "dependsOrder": "sequence",
      "dependsOn": [
        "🧪 Phase 1: Pull Photos",
        "🧪 Phase 1: Analyze EXIF"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    }
  ],
  "inputs": [
    {
      "id": "hybridTopic",
      "type": "promptString",
      "description": "輸入本次任務 topic（用於檔名）",
      "default": "camera_control_not_available"
    },
    {
      "id": "hybridInput",
      "type": "promptString",
      "description": "輸入需求/問題描述（可直接貼錯誤訊息、重現條件、裝置差異）",
      "default": "實體手機切回 Live 模式後呼叫 setZoomRatio 出現 CameraControl not available；模擬器未重現。"
    },
    {
      "id": "hybridInputFile",
      "type": "promptString",
      "description": "輸入 input_file 路徑（例如 logs/logcat.txt 或 notes/issue.md）",
      "default": "logs/logcat.txt"
    },
    {
      "id": "hybridIssuePath",
      "type": "promptString",
      "description": "輸入 Issue/計畫檔路徑（L2 建議填 L1 產出，如 docs/plan/<topic>_L1.md）",
      "default": "docs/plan/camera_control_not_available_L1.md"
    }
  ]
}
