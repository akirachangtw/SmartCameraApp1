{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Test Handoff Manager (Python GUI)",
            "type": "shell",
            "command": "python",
            "args": [
                "tools/test_handoff_gui.pyw"
            ],
            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "🚀 Build Emulator Debug",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": [
                "assembleEmulatorDebug"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "📱 Install to Emulator",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": [
                "installEmulatorDebug"
            ],
            "group": "build",
            "dependsOn": [
                "🚀 Build Emulator Debug"
            ],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "🧪 Run Unit Tests",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": [
                "testEmulatorDebugUnitTest"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "🔍 Run Lint",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": [
                "lintEmulatorDebug"
            ],
            "group": "test"
        },
        {
            "label": "🧹 Clean Build",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": [
                "clean"
            ],
            "group": "build"
        },
        {
            "label": "📋 Hybrid: L1 Plan (inline input)",
            "type": "shell",
            "command": "python",
            "args": [
                "tools/hybrid_flow.py",
                "--level",
                "L1",
                "--topic",
                "${input:hybridTopic}",
                "--input",
                "${input:hybridInput}",
                "--out",
                "docs/plan",
                "--repo",
                "${workspaceFolder}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "hybridTopic",
            "type": "promptString",
            "description": "輸入本次任務 topic（用於檔名）",
            "default": "camera_control_not_available"
        },
        {
            "id": "hybridInput",
            "type": "promptString",
            "description": "輸入需求/問題描述",
            "default": "實體手機切回 Live 模式後呼叫 setZoomRatio 出現 CameraControl not available"
        }
    ]
}