{
  "version": "2.0.0",
  "// NOTE": "This file has been integrated into .vscode/tasks.json",
  "// INFO": "You can use tasks directly from VSCode Task Runner (Ctrl+Shift+P -> Run Task)",
  "// REFERENCE": "See .vscode/tasks.json for the active task configuration",
  "tasks": [
    {
      "label": "Hybrid: L1 Plan (inline input)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "L1",
        "--topic",
        "${input:hybridTopic}",
        "--input",
        "${input:hybridInput}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Hybrid: L1 Plan (input_file)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "L1",
        "--topic",
        "${input:hybridTopic}",
        "--input_file",
        "${input:hybridInputFile}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Hybrid: L2 Feasibility (inline input)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "L2",
        "--topic",
        "${input:hybridTopic}",
        "--issue",
        "${input:hybridIssuePath}",
        "--input",
        "${input:hybridInput}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Hybrid: L2 Feasibility (input_file)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "L2",
        "--topic",
        "${input:hybridTopic}",
        "--issue",
        "${input:hybridIssuePath}",
        "--input_file",
        "${input:hybridInputFile}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Hybrid: PR Notes (inline input)",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/hybrid_flow.py",
        "--level",
        "PR",
        "--topic",
        "${input:hybridTopic}",
        "--input",
        "${input:hybridInput}",
        "--out",
        "docs/plan",
        "--repo",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "hybridTopic",
      "type": "promptString",
      "description": "輸入本次任務 topic（用於檔名）",
      "default": "camera_control_not_available"
    },
    {
      "id": "hybridInput",
      "type": "promptString",
      "description": "輸入需求/問題描述（可直接貼錯誤訊息、重現條件、裝置差異）",
      "default": "實體手機切回 Live 模式後呼叫 setZoomRatio 出現 CameraControl not available；模擬器未重現。"
    },
    {
      "id": "hybridInputFile",
      "type": "promptString",
      "description": "輸入 input_file 路徑（例如 logs/logcat.txt 或 notes/issue.md）",
      "default": "logs/logcat.txt"
    },
    {
      "id": "hybridIssuePath",
      "type": "promptString",
      "description": "輸入 Issue/計畫檔路徑（L2 建議填 L1 產出，如 docs/plan/<topic>_L1.md）",
      "default": "docs/plan/camera_control_not_available_L1.md"
    }
  ]
}