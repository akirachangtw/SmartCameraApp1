# ⚠️ IMPORTANT: DO NOT add these critical files to .gitignore
# tools/hybrid_flow.py - Required for development workflow
# tools/hybrid_flow-tasks.json - Required for VSCode Tasks
# tools/HYBRID_FLOW_CLAUDE_USAGE.md - Documentation
# .claude/settings.local.json - Already ignored (line 26)
# See tools/.gitkeep_critical_files for details

# Personal local settings (machine-specific, not shared)
CLAUDE.local.md
normal_dump.xml

# Session handoff docs (auto-generated by Claude Code, not committed)
docs/session_handoff/

# CSO / UITA project knowledge (local AI agent context, not committed)
# Exception: TICKET_REGISTRY.json is a Governance Artifact (project-scoped status
# dashboard, tracked by CSO ruling 2026-07-28) — Manifest (cross-project) stays
# untracked; Registry (this repo's own state) is version-controlled.
plans/cso_briefing/*
!plans/cso_briefing/project/
plans/cso_briefing/project/*
!plans/cso_briefing/project/TICKET_REGISTRY.json
plans/uita_project/
plans/archive/

# MEO (model-effort-orchestrator) runtime signal file — mechanical values only, not committed (MEO-T3 AI-7)
STATE.md

# Understand-Anything (UA) — 中間產物不入 git
.understand-anything/intermediate/
.understand-anything/diff-overlay.json
.understand-anything/tmp/
.understand-anything/.trash-*/
# UA 誤跑於 src/ 子目錄的殘留產物（正確位置為專案根目錄）
app/src/**/.understand-anything/
headroom_memory.db

# Local MCP server config (per-machine, not committed)
.mcp.json

# Memory MCP 圖譜資料（Cueshot-memory 專案工作上下文，機器本地、不入 git）
.mcp-memory/
