{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MEO Derived State",
  "type": "object",
  "required": ["ticket_id", "generated_at", "active_sessions"],
  "properties": {
    "ticket_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "latest_diagnosis": { "type": "object" },
    "latest_action_plan": { "type": "object" },
    "open_verification_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unresolved_escalations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "active_sessions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "touched_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "last_sync_commit": { "type": "object" },
    "last_review_result": { "type": "object" },
    "timeout_risk_flag": { "type": "boolean" },
    "session_conflict_flag": { "type": "boolean" }
  },
  "additionalProperties": true
}
