{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ticket-repair-response/v1",
  "type": "object",
  "required": ["schema_version", "ticket_id", "finding_results", "run_summary"],
  "properties": {
    "schema_version": { "const": "ticket-repair-response/v1" },
    "ticket_id": { "type": "string", "minLength": 1 },
    "finding_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "disposition", "reason"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "disposition": {
            "type": "string",
            "enum": [
              "propose_repair",
              "escalate_to_human",
              "insufficient_evidence",
              "out_of_range",
              "no_change_needed"
            ]
          },
          "reason": { "type": "string" },
          "source_refs_used": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": { "type": "string" },
                "lines": { "type": "string" }
              }
            }
          },
          "patch": {
            "type": "object",
            "properties": {
              "target_file": { "type": "string" },
              "target_section": { "type": "string" },
              "expected_old_text_hash": { "type": "string" },
              "replacement_text": { "type": "string" }
            }
          },
          "changed_line_estimate": { "type": "integer", "minimum": 0 },
          "requires_human_decision": { "type": "boolean" },
          "verification_hints": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "run_summary": {
      "type": "object",
      "required": ["model", "reasoning_effort"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "type": "string", "minLength": 1 },
        "prompt_template_version": { "type": "string" }
      }
    }
  }
}
